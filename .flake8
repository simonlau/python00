[flake8]
# Check for deep code nesting and logical complexity (McCabe complexity)
max-complexity = 7

# Override Flake8's default ignore list
# By default, Flake8 ignores E121, E123, E126, E226, E24, E704, W503, and W504.
# Setting ignore to empty enforces strict PEP 8 compliance.
ignore =

# Exclude typical auto-generated or external dependency directories
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    dist,
    build,
    docs


# Output and statistics
show-source = True
count = True
statistics = True
